# Copie para .env e ajuste. NUNCA versione o arquivo .env.
NODE_ENV=production
PORT=3000
APP_NAME=Licita Inteligente
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=12h
DB_PATH=./storage/licita.db
SCHEDULER=on
HTTP_USER_AGENT=LicitaInteligente/0.2 (contato: seu-email@dominio.com.br)
HTTP_TIMEOUT_MS=30000
# Intervalo mínimo entre chamadas ao mesmo site (ms) e espera inicial após HTTP 429 (ms)
HTTP_MIN_INTERVAL_MS=1000
HTTP_ESPERA_429_MS=15000
# Atrás de proxy corporativo (Node >= 22.21):
# NODE_USE_ENV_PROXY=1
# E-mail do sistema. No Railway Hobby o SMTP é bloqueado: use BREVO_API_KEY (API HTTPS do Brevo) com EMAIL_REMETENTE verificado.
BREVO_API_KEY=
# Alternativa SMTP (Railway Pro ou outro servidor). Gmail: use uma "senha de app" (exige verificação em 2 etapas).
# Ex.: smtps://guidolicitacoes%40gmail.com:SENHA_DE_APP_SEM_ESPACOS@smtp.gmail.com:465  (o @ do usuário vira %40)
SMTP_URL=
# Remetente exibido, ex.: Nome <email@gmail.com> (obrigatório com Brevo; com SMTP o padrão é o usuário da SMTP_URL)
EMAIL_REMETENTE=
# Endereço público do sistema, usado nos links dos e-mails e do calendário (opcional)
APP_URL=
